# ===================================================================
#  SQL Query Practice - Environment Configuration Template
#  Copy this file to `.env` and fill in your values.
# ===================================================================

# --- Django Core Settings ---
# Set DEBUG=False for production deployment; True for local debugging
DEBUG=False

# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key

# Comma-separated allowed hostnames (e.g. your domain, *.onrender.com, *.railway.app, localhost, 127.0.0.1)
ALLOWED_HOSTS=*

# Comma-separated trusted origins for CSRF protection over HTTPS (e.g. https://your-app.onrender.com)
CSRF_TRUSTED_ORIGINS=

# --- Application Database (Students, progress, submissions, approvals) ---
# Supabase PostgreSQL (Session pooler recommended):
# e.g.: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Or for local development: sqlite:///retailmart.sqlite3
APP_DATABASE_URL=sqlite:///retailmart.sqlite3

# --- Practice Database (RetailMart dataset questions run against) ---
# Connection string for the PostgreSQL database holding the practice tables:
# e.g.: postgresql://username:password@hostname:5432/isct_retailmart
PRACTICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/isct_retailmart

# --- Sandbox execution limits ---
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=500
DB_POOL_MAX=10
ALLOW_ANSWER_REVEAL=true
SCHEMA_EXCLUDE=

# --- AI Answer Checker (Optional) ---
# Primary LLM provider (Ollama Cloud or OpenAI-compatible endpoint)
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:120b
LLM_API_KEY=

# Fallback LLM provider (Google Gemini API - https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Email / Password Reset (Optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
RESET_LINK_HOURS=24

# --- Local Server Settings ---
PORT=5000
THREADS=16
